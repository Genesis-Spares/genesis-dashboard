# Copy to .env.local for `pnpm dev`. NEXT_PUBLIC_* values are baked in at build time.

# Genesis API gateway, as the admin's browser reaches it
NEXT_PUBLIC_API_URL=http://localhost:11000/api

# Cloudinary unsigned upload preset for product images
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
